{
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "200000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "75"
  },
  "permissions": {
    "allow": [
      "mcp__litellm__duckduckgo-fetch_content",
      "mcp__litellm__duckduckgo-search",
      "mcp__litellm__github-get_file_contents",
      "mcp__litellm__github-get_issue",
      "mcp__litellm__github-get_pull_request",
      "mcp__litellm__github-get_pull_request_comments",
      "mcp__litellm__github-get_pull_request_files",
      "mcp__litellm__github-get_pull_request_reviews",
      "mcp__litellm__github-get_pull_request_status",
      "mcp__litellm__github-list_commits",
      "mcp__litellm__github-list_issues",
      "mcp__litellm__github-list_pull_requests",
      "mcp__litellm__github-search_code",
      "mcp__litellm__github-search_issues",
      "mcp__litellm__github-search_repositories",
      "mcp__litellm__github-search_users",
      "Bash(sed *)",
      "Bash(mkdir -p *.claude/swarm*)",
      "Bash(rm -f .claude/swarm/active.json)",
      "Bash(rm -f *.claude/swarm/active.json)",
      "Bash(cat .claude/swarm/*)",
      "Bash(ln -sfn * *.claude/swarm/*)",
      "Bash(ln -sfn * .claude/swarm/*)",
      "Write(*/.claude/swarm/**)",
      "Write(*.claude/swarm/**)",
      "Write(.claude/swarm/**)",
      "Edit(*.claude/swarm/**)",
      "Edit(.claude/swarm/**)",
      "Skill(*)",
      "Agent",
      "SendMessage",
      "TaskCreate",
      "TaskUpdate",
      "TaskList",
      "TaskGet",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(stat *)",
      "Bash(cat *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh release view *)",
      "Bash(gh release list *)",
      "Bash(gh repo view *)",
      "Bash(gh search *)",
      "Bash(docker inspect *)",
      "Bash(docker ps *)",
      "Bash(docker stats *)",
      "Bash(docker images *)",
      "Bash(docker logs *)",
      "Bash(docker volume ls *)",
      "Bash(docker manifest *)",
      "Bash(npm view *)",
      "Bash(npm info *)",
      "Bash(npm search *)",
      "Bash(op whoami *)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:pypi.org)",
      "WebFetch(domain:hub.docker.com)"
    ]
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash {{ .chezmoi.homeDir }}/.claude/hooks/set-iterm-title.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash {{ .chezmoi.homeDir }}/.claude/statusline-command.sh",
    "refreshInterval": 10,
    "hideVimModeIndicator": true
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "bash {{ .chezmoi.homeDir }}/.claude/subagent-statusline.sh"
  },
  "enabledPlugins": {
    "swarm@local": true,
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "obsidian@obsidian-skills": true
  },
  "extraKnownMarketplaces": {
    "local": {
      "source": {
        "source": "directory",
        "path": "{{ .chezmoi.homeDir }}/.claude/plugins/swarm"
      },
      "autoUpdate": true
    },
    "claude-plugins-official": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-plugins-official.git"
      }
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "teammateMode": "in-process",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "theme": "auto"
}
